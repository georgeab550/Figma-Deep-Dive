{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical screen registry",
  "type": "object",
  "required": ["file", "screens"],
  "properties": {
    "file": { "type": "string" },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["screen", "buildOnce", "variants"],
        "properties": {
          "screen": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
          "buildOnce": { "type": "boolean" },
          "differsBy": { "type": "array", "items": { "type": "string" } },
          "variants": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["entry", "frame"],
              "properties": {
                "entry": { "type": "string" },
                "frame": { "type": "string", "pattern": "^[0-9]+[:-][0-9]+$" }
              },
              "additionalProperties": true
            }
          },
          "sharedSubComponents": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
